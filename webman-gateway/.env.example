# Webman 网关环境变量示例（复制为 .env 生效，docker-compose 内由 environment 提供）

# RPC 服务地址（compose 内用服务名：tcp://mysql-rpc:9501）
RPC_ADDRESS=tcp://127.0.0.1:9501

# 回滚开关：0 = 降级为同步 PDO 直连（逃生通道）
RPC_ENABLE=1

# PDO 回滚模式用的直连配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=test

{
  "name": "fiber-db-pool/gateway",
  "type": "project",
  "keywords": [
    "fiber",
    "coroutine",
    "mysql",
    "connection pool",
    "json-rpc",
    "webman",
    "workerman"
  ],
  "license": "MIT",
  "description": "fiber-db-pool HTTP gateway: Workerman Fiber event loop + async JSON-RPC MySQL client (Swoole-free)",
  "authors": [
    {
      "name": "tikobus"
    }
  ],
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "revolt/event-loop": "^1.1"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "post-create-project-cmd": [
      "support\\Setup::run"
    ],
    "setup-webman": [
      "support\\Setup::run"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
